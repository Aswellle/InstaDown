{
  "name": "instadownloader",
  "productName": "InstaDownloader",
  "version": "0.3.1",
  "description": "本地优先的 Instagram 媒体归档工具",
  "main": "./out/main/index.js",
  "author": "InstaDownloader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:py": "python -m unittest discover -s worker/tests -v",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.5"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aswellle/InstaDown.git"
  },
  "homepage": "https://github.com/Aswellle/InstaDown#readme",
